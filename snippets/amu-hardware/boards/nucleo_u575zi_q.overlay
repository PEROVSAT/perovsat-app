&i2c1 {
	status = "okay";

	// Enabled

	amu_z_ps0: amu@f {
		compatible = "aerospace,amu";
		reg = <0x0f>;
		status = "okay";
		amu-type = <1>;
		amu-delay = <1>;
		amu-ratio = <75>;
		amu-power = <0>;
		amu-dac-gain = <1>;
		amu-sweep-averages = <1>;
		amu-adc-averages = <4>;
		amu-am0-mw = <1366100>;
		amu-area-ucm2 = <4>;
	};

	// Disabled (for testing, but flight config should enable)

	amu_z_ref0: amu@8 {
		compatible = "aerospace,amu";
		reg = <0x08>;
		status = "disabled";
	};
	amu_z_ref1: amu@9 {
		compatible = "aerospace,amu";
		reg = <0x09>;
		status = "disabled";
	};
	amu_z_ps1: amu@a {
		compatible = "aerospace,amu";
		reg = <0x0a>;
		status = "disabled";
	};
	amu_z_ps2: amu@b {
		compatible = "aerospace,amu";
		reg = <0x0b>;
		status = "disabled";
	};
	amu_z_ps3: amu@c {
		compatible = "aerospace,amu";
		reg = <0x0c>;
		status = "disabled";
	};
	amu_z_ps4: amu@d {
		compatible = "aerospace,amu";
		reg = <0x0d>;
		status = "disabled";
	};
	amu_z_ps5: amu@e {
		compatible = "aerospace,amu";
		reg = <0x0e>;
		status = "disabled";
	};
	amu_x_ref0: amu@10 {
		compatible = "aerospace,amu";
		reg = <0x10>;
		status = "disabled";
	};
	amu_x_ref1: amu@11 {
		compatible = "aerospace,amu";
		reg = <0x11>;
		status = "disabled";
	};
	amu_x_ps0: amu@12 {
		compatible = "aerospace,amu";
		reg = <0x12>;
		status = "disabled";
	};
	amu_x_ps1: amu@13 {
		compatible = "aerospace,amu";
		reg = <0x13>;
		status = "disabled";
	};
	amu_x_ps2: amu@14 {
		compatible = "aerospace,amu";
		reg = <0x14>;
		status = "disabled";
	};
	amu_x_ps3: amu@15 {
		compatible = "aerospace,amu";
		reg = <0x15>;
		status = "disabled";
	};
	amu_x_ps4: amu@16 {
		compatible = "aerospace,amu";
		reg = <0x16>;
		status = "disabled";
	};
	amu_x_ps5: amu@17 {
		compatible = "aerospace,amu";
		reg = <0x17>;
